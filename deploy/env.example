# Copy to /opt/codeassure/.env on the server and fill in. Never commit the real file.

# --- Where people open the app (no trailing slash) ---
PUBLIC_URL=http://144.76.239.170
# true only once the site is served over HTTPS
COOKIE_SECURE=false

# --- Secrets: generate each with the command shown ---
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
AUTH_SECRET_KEY=
# openssl rand -base64 32 | tr '+/' '-_'
SETTINGS_ENCRYPTION_KEY=

# --- First admin account (created only when the database has no users) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Azure OpenAI (copy from your development .env) ---
OPENAI_API_BASE=
OPENAI_API_VERSION=
OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_KEY=

# --- Microsoft sign-in (needs an https PUBLIC_URL; leave empty until then) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- Email (copy from your development .env; wrap the password in single quotes) ---
EMAIL_MODE=log
EMAIL_FROM=
EMAIL_FROM_NAME=CodeAssure
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=''
SMTP_STARTTLS=true
